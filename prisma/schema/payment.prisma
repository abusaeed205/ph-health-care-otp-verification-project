model Payment {
  id String @id @default(uuid())

  amount Decimal @db.Decimal(10, 2) //দশমিকের পরে 2ঘর নিবে

  currency              String @default("BDT")
  paymentGateway        String @default("bkash")
  merchantInvoiceNumber String @unique //appointment id

  bkashPaymentId String? @unique
  bkashTrxId     String?
  payerReferance String //user email/phone number
  paidAt         String?

  gatewayResponse Json?

  refundTrxId  String?
  refundAmount Decimal? @db.Decimal(10, 2)
  refundReason String?
  refundedAt   String?

  appointmentID String        @unique
  appointment   Appointment   @relation(fields: [appointmentID], references: [id], onDelete: Cascade, onUpdate: Cascade)
  status        PaymentStatus @default(UNPAID)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

// gatewayResponse Json? মূলত bKash/Payment Gateway থেকে আসা পুরো response সংরক্ষণ করার জন্য ব্যবহার করবে।
